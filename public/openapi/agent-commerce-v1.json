{
  "openapi": "3.0.3",
  "info": {
    "title": "Veyra Agent API",
    "version": "1.2.0",
    "description": "Machine API for verified Veyra workflows and continuous trust monitoring."
  },
  "servers": [
    {
      "url": "https://agent-commerce-six.vercel.app",
      "description": "Arc Testnet Production Server"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/agent/v1/workflows": {
      "get": {
        "summary": "List available workflows",
        "description": "Returns available workflow templates, input schemas, list prices, and Arc Testnet metadata. Requires `workflows:read` credential scope.",
        "operationId": "listWorkflows",
        "responses": {
          "200": {
            "description": "List of available workflows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string",
                      "example": "1"
                    },
                    "workflows": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WorkflowTemplate"
                      }
                    }
                  },
                  "required": ["version", "workflows"]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/agent/v1/quotes": {
      "post": {
        "summary": "Create workflow quote",
        "description": "Generates an immutable workflow quote with list price and required payment details. Requires `quotes:create` scope and `Idempotency-Key` header.",
        "operationId": "createQuote",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkflowQuoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote created or returned from cache (idempotent)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowQuoteResponse"
                }
              }
            }
          },
          "201": {
            "description": "Quote successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowQuoteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/api/agent/v1/runs": {
      "post": {
        "summary": "Launch workflow execution",
        "description": "Launches execution for a valid quote. Supports sponsored quota or paid x402 transaction hash. Requires `runs:create` scope and `Idempotency-Key` header.",
        "operationId": "launchRun",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunLaunchRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run queued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunLaunchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/api/agent/v1/runs/{runId}": {
      "get": {
        "summary": "Poll run execution status",
        "description": "Retrieves the current execution status, stage, progress, and reportId upon completion. Scoped to credential owner. Requires `results:read` scope.",
        "operationId": "getRunStatus",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "description": "The run identifier returned from POST /api/agent/v1/runs",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current run execution status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatusResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/agent/v1/reports/{reportId}": {
      "get": {
        "summary": "Retrieve structured report",
        "description": "Returns the completed structured report and Arc verification proofs. Supports `Accept: application/json` or `Accept: text/markdown`. Requires `results:read` scope.",
        "operationId": "getReport",
        "parameters": [
          {
            "name": "reportId",
            "in": "path",
            "required": true,
            "description": "The report identifier (matches runId)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "Media type negotiation: `application/json` (default) or `text/markdown`",
            "schema": {
              "type": "string",
              "enum": ["application/json", "text/markdown"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Structured JSON report or formatted Markdown text",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/StructuredReportResponse" },
                    { "$ref": "#/components/schemas/AgentTrustReportResponse" }
                  ]
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Report not ready yet (`report_not_ready`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MachineError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/agent/v1/watchlists": {
      "get": {
        "summary": "List credential-scoped trust watchlists",
        "operationId": "listWatchlists",
        "description": "Lists only watchlists owned by the exact Machine API agent and credential. Requires `results:read` scope.",
        "responses": {
          "200": {
            "description": "Credential-scoped watchlists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["watchlists"],
                  "properties": {
                    "watchlists": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/TrustWatchlist" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "post": {
        "summary": "Create a trust watchlist",
        "operationId": "createWatchlist",
        "description": "Saves public Agent Trust Report input for manual, daily, or weekly rechecks. Requires `runs:create` scope and `Idempotency-Key`.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["input"],
                "properties": {
                  "label": { "type": "string", "minLength": 2, "maxLength": 100 },
                  "input": { "$ref": "#/components/schemas/AgentTrustReportInput" },
                  "cadence": {
                    "type": "string",
                    "enum": ["manual", "daily", "weekly"],
                    "default": "manual"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing idempotent watchlist",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TrustWatchlist" }
              }
            }
          },
          "201": {
            "description": "Watchlist created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TrustWatchlist" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/agent/v1/watchlists/{watchlistId}": {
      "get": {
        "summary": "Retrieve trust history",
        "operationId": "getWatchlist",
        "description": "Returns the current report, deterministic delta, and Arc proof for every snapshot. An unowned watchlist returns 404.",
        "parameters": [{
          "name": "watchlistId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "pattern": "^wtl_[0-9a-f]{20}$" }
        }],
        "responses": {
          "200": {
            "description": "Trust monitoring history",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TrustHistory" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/agent/v1/watchlists/{watchlistId}/rechecks": {
      "post": {
        "summary": "Create an immutable recheck quote",
        "operationId": "createWatchlistRecheck",
        "description": "Creates a credential-owned Agent Trust Report quote linked to the watchlist. Launch the returned `quoteId` through POST `/api/agent/v1/runs`.",
        "parameters": [
          {
            "name": "watchlistId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^wtl_[0-9a-f]{20}$" }
          },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": {
            "description": "Existing idempotent recheck quote",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TrustRecheckQuote" }
              }
            }
          },
          "201": {
            "description": "Recheck quote created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TrustRecheckQuote" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "aac_live_...",
        "description": "Veyra Agent API Bearer credential token (`aac_live_...`)"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Unique key to ensure request idempotency (e.g. UUIDv4)",
        "schema": {
          "type": "string",
          "example": "idemp_9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
        }
      }
    },
    "schemas": {
      "MachineError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "retryable", "requestId"],
            "properties": {
              "code": {
                "type": "string",
                "example": "invalid_repository",
                "description": "Stable Machine API error code. Idempotent mutations may return idempotency_key_missing, idempotency_conflict, idempotency_in_progress, or idempotency_store_unavailable."
              },
              "message": {
                "type": "string",
                "example": "Enter a valid GitHub repository in owner/repository format."
              },
              "retryable": {
                "type": "boolean",
                "example": false
              },
              "requestId": {
                "type": "string",
                "example": "req_8f12a45b7e90"
              }
            }
          }
        }
      },
      "WorkflowTemplate": {
        "type": "object",
        "required": ["id", "name", "shortName", "description", "task", "estimatedUsdc", "inputSchema", "arc"],
        "properties": {
          "id": {
            "type": "string",
            "example": "github_due_diligence"
          },
          "name": {
            "type": "string",
            "example": "GitHub Due Diligence"
          },
          "shortName": {
            "type": "string",
            "example": "GitHub Diligence"
          },
          "description": {
            "type": "string",
            "example": "Comprehensive technical due diligence for open-source GitHub repositories."
          },
          "task": {
            "type": "string",
            "example": "Evaluate repository health, architecture, security, activity, and risks"
          },
          "estimatedUsdc": {
            "type": "number",
            "example": 0.002
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "example": "object" },
              "properties": { "type": "object" },
              "required": { "type": "array", "items": { "type": "string" } }
            }
          },
          "arc": {
            "type": "object",
            "properties": {
              "chainId": { "type": "number", "example": 5042002 },
              "network": { "type": "string", "example": "arc-testnet" },
              "asset": { "type": "string", "example": "USDC" },
              "tokenAddress": { "type": "string", "example": "0x3600000000000000000000000000000000000000" }
            }
          }
        }
      },
      "TrustWatchlist": {
        "type": "object",
        "required": [
          "id", "label", "input", "cadence", "status", "currentScore",
          "verificationStatus", "publicHistoryUrl", "createdAt", "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^wtl_[0-9a-f]{20}$" },
          "label": { "type": "string" },
          "input": { "$ref": "#/components/schemas/AgentTrustReportInput" },
          "cadence": { "type": "string", "enum": ["manual", "daily", "weekly"] },
          "status": { "type": "string", "enum": ["active", "paused"] },
          "nextRecheckAt": { "type": "string", "format": "date-time", "nullable": true },
          "lastRecheckAt": { "type": "string", "format": "date-time", "nullable": true },
          "currentScore": { "type": "integer", "minimum": 0, "maximum": 100, "nullable": true },
          "trustStatus": { "type": "string", "nullable": true },
          "verificationStatus": { "type": "string", "nullable": true },
          "latestSnapshotId": { "type": "string", "nullable": true },
          "publicHistoryUrl": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TrustDeltaReport": {
        "type": "object",
        "required": ["kind", "version", "previousSnapshotId", "currentSnapshotId", "score", "summary", "changes", "generatedAt"],
        "properties": {
          "kind": { "type": "string", "enum": ["trust_delta_report"] },
          "version": { "type": "integer", "enum": [1] },
          "previousSnapshotId": { "type": "string", "nullable": true },
          "currentSnapshotId": { "type": "string" },
          "score": {
            "type": "object",
            "properties": {
              "before": { "type": "integer", "nullable": true },
              "after": { "type": "integer", "nullable": true },
              "change": { "type": "integer", "nullable": true },
              "direction": { "type": "string", "enum": ["improved", "declined", "unchanged", "unavailable"] }
            }
          },
          "summary": { "type": "object", "additionalProperties": { "type": "integer" } },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "kind", "severity", "category", "title", "summary", "before", "after"],
              "properties": {
                "code": { "type": "string" },
                "kind": { "type": "string", "enum": ["new_risk", "improved", "activity", "status_change", "changed"] },
                "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
                "category": { "type": "string" },
                "title": { "type": "string" },
                "summary": { "type": "string" },
                "before": { "nullable": true },
                "after": { "nullable": true }
              }
            }
          },
          "generatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TrustHistory": {
        "type": "object",
        "required": ["watchlist", "currentReport", "currentDelta", "history"],
        "properties": {
          "watchlist": {
            "type": "object",
            "required": ["id", "label", "input", "cadence", "status", "lastCheckedAt", "nextRecheckAt"],
            "properties": {
              "id": { "type": "string", "pattern": "^wtl_[0-9a-f]{20}$" },
              "label": { "type": "string" },
              "input": { "$ref": "#/components/schemas/AgentTrustReportInput" },
              "cadence": { "type": "string", "enum": ["manual", "daily", "weekly"] },
              "status": { "type": "string", "enum": ["active", "paused"] },
              "lastCheckedAt": { "type": "string", "format": "date-time", "nullable": true },
              "nextRecheckAt": { "type": "string", "format": "date-time", "nullable": true }
            }
          },
          "currentReport": {
            "oneOf": [
              { "$ref": "#/components/schemas/AgentTrustReportResponse" },
              { "type": "null" }
            ]
          },
          "currentDelta": {
            "oneOf": [
              { "$ref": "#/components/schemas/TrustDeltaReport" },
              { "type": "null" }
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["snapshotId", "jobId", "sequence", "score", "trustStatus", "reportHash", "verificationStatus", "proofTransactionHash", "proofUrl", "observedAt", "delta", "reportUrl"],
              "properties": {
                "snapshotId": { "type": "string" },
                "jobId": { "type": "string" },
                "sequence": { "type": "integer" },
                "score": { "type": "integer", "nullable": true },
                "trustStatus": { "type": "string" },
                "reportHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
                "verificationStatus": { "type": "string" },
                "proofTransactionHash": { "type": "string", "nullable": true },
                "proofUrl": { "type": "string", "nullable": true },
                "observedAt": { "type": "string", "format": "date-time" },
                "delta": { "$ref": "#/components/schemas/TrustDeltaReport" },
                "reportUrl": { "type": "string" }
              }
            }
          }
        }
      },
      "TrustRecheckQuote": {
        "allOf": [
          { "$ref": "#/components/schemas/WorkflowQuoteResponse" },
          {
            "type": "object",
            "required": ["watchlistId", "recheckId"],
            "properties": {
              "watchlistId": { "type": "string", "pattern": "^wtl_[0-9a-f]{20}$" },
              "recheckId": { "type": "string", "pattern": "^trc_[0-9a-f]{20}$" }
            }
          }
        ]
      },
      "WorkflowQuoteRequest": {
        "type": "object",
        "required": ["workflow"],
        "properties": {
          "workflow": {
            "type": "string",
            "example": "github_due_diligence"
          },
          "repository": {
            "type": "string",
            "example": "circlefin/agent-commerce"
          },
          "input": {
            "oneOf": [
              { "$ref": "#/components/schemas/AgentTrustReportInput" },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "repository": { "type": "string", "example": "circlefin/agent-commerce" }
                }
              }
            ]
          }
        }
      },
      "AgentTrustReportInput": {
        "type": "object",
        "description": "Public identifiers for Veyra Agent Trust Report. At least one primary identifier is required.",
        "properties": {
          "agentId": {
            "type": "string",
            "pattern": "^agt_[a-z0-9]{20}$",
            "example": "agt_0123456789abcdefghij"
          },
          "agentWallet": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "repositoryUrl": {
            "type": "string",
            "example": "circlefin/developer-controlled-wallets-web-sdk"
          },
          "contractAddress": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "Optional Arc Testnet contract address"
          },
          "serviceEndpoint": {
            "type": "string",
            "format": "uri",
            "description": "Optional public HTTPS endpoint; localhost and private networks are blocked"
          }
        },
        "anyOf": [
        { "required": ["agentId"] },
        { "required": ["agentWallet"] },
        { "required": ["repositoryUrl"] },
        { "required": ["contractAddress"] },
        { "required": ["serviceEndpoint"] }
      ]
      },
      "WorkflowQuoteResponse": {
        "type": "object",
        "required": ["quoteId", "workflow", "totalUsdc", "sponsored", "expiresAt", "requiredPayment"],
        "properties": {
          "quoteId": {
            "type": "string",
            "example": "qte_9f81a2b3c4d5"
          },
          "workflow": {
            "type": "string",
            "example": "github_due_diligence"
          },
          "repository": {
            "type": "object",
            "nullable": true,
            "properties": {
              "fullName": { "type": "string", "example": "circlefin/agent-commerce" },
              "canonicalUrl": { "type": "string", "example": "https://github.com/circlefin/agent-commerce" }
            }
          },
          "totalUsdc": {
            "type": "number",
            "example": 0.002
          },
          "sponsored": {
            "type": "boolean",
            "example": true
          },
          "checkout": {
            "type": "object",
            "properties": {
              "mode": { "type": "string", "enum": ["sponsored", "arc_transaction"], "example": "sponsored" },
              "asset": { "type": "string", "example": "USDC" },
              "network": { "type": "string", "example": "arc-testnet" }
            }
          },
          "downstreamSettlement": {
            "type": "string",
            "example": "server_side_x402"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-24T22:15:00.000Z"
          },
          "requiredPayment": {
            "type": "object",
            "properties": {
              "network": { "type": "string", "example": "arc-testnet" },
              "asset": { "type": "string", "example": "USDC" },
              "amount": { "type": "number", "example": 0.0 },
              "treasuryAddress": { "type": "string", "example": "0x742d35Cc6634C0532925a3b844Bc454e4438f44e" },
              "chainId": { "type": "number", "example": 5042002 }
            }
          }
        }
      },
      "RunLaunchRequest": {
        "type": "object",
        "required": ["quoteId"],
        "properties": {
          "quoteId": {
            "type": "string",
            "example": "qte_9f81a2b3c4d5"
          },
          "paymentAuthorization": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "example": "arc_transaction" },
              "payload": { "type": "string", "example": "0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef" }
            }
          }
        }
      },
      "RunLaunchResponse": {
        "type": "object",
        "required": ["runId", "status", "pollAfterMs"],
        "properties": {
          "runId": {
            "type": "string",
            "example": "job_01h9a8b7c6d5"
          },
          "status": {
            "type": "string",
            "example": "queued"
          },
          "pollAfterMs": {
            "type": "number",
            "example": 2000
          }
        }
      },
      "RunStatusResponse": {
        "type": "object",
        "required": ["runId", "status", "progress", "stage", "pollAfterMs"],
        "properties": {
          "runId": {
            "type": "string",
            "example": "job_01h9a8b7c6d5"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "running", "completed", "completed_with_warnings", "failed", "expired"],
            "example": "completed"
          },
          "progress": {
            "type": "number",
            "example": 1.0
          },
          "stage": {
            "type": "string",
            "example": "completed"
          },
          "pollAfterMs": {
            "type": "number",
            "example": 0
          },
          "reportId": {
            "type": "string",
            "example": "job_01h9a8b7c6d5"
          },
          "verification": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "example": "verified" },
              "verifiedSteps": { "type": "number", "example": 2 },
              "requiredSteps": { "type": "number", "example": 2 }
            }
          }
        }
      },
      "StructuredReportResponse": {
        "type": "object",
        "required": [
          "reportId",
          "workflow",
          "repository",
          "status",
          "executiveSummary",
          "projectPurpose",
          "technology",
          "activity",
          "strengths",
          "risks",
          "questionsBeforeAdoption",
          "confidence",
          "verification",
          "generatedAt"
        ],
        "properties": {
          "reportId": { "type": "string", "example": "job_01h9a8b7c6d5" },
          "workflow": { "type": "string", "example": "github_due_diligence" },
          "repository": {
            "type": "object",
            "nullable": true,
            "properties": {
              "fullName": { "type": "string", "example": "circlefin/agent-commerce" },
              "canonicalUrl": { "type": "string", "example": "https://github.com/circlefin/agent-commerce" }
            }
          },
          "status": { "type": "string", "example": "completed" },
          "verdict": {
            "type": "object",
            "nullable": true,
            "required": ["code", "label", "confidence", "summary", "reasons", "blockingFindings", "evidenceCoverage"],
            "properties": {
              "code": {
                "type": "string",
                "enum": ["proceed_with_standard_review", "proceed_with_conditions", "pause_for_review", "insufficient_evidence"]
              },
              "label": { "type": "string", "example": "Proceed with standard review" },
              "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
              "summary": { "type": "string" },
              "reasons": { "type": "array", "items": { "type": "string" } },
              "blockingFindings": { "type": "array", "items": { "type": "string" } },
              "evidenceCoverage": {
                "type": "object",
                "properties": {
                  "assessedCategories": { "type": "number" },
                  "highConfidenceCategories": { "type": "number" },
                  "totalCategories": { "type": "number" },
                  "ratio": { "type": "number" }
                }
              }
            }
          },
          "executiveSummary": { "type": "string", "example": "Repository due diligence completed with strong governance and regular commit activity." },
          "projectPurpose": {
            "type": "object",
            "properties": {
              "summary": { "type": "string" },
              "primaryInterface": { "type": "string" },
              "developmentStage": { "type": "string" },
              "targetUsers": { "type": "string" },
              "capabilities": { "type": "array", "items": { "type": "string" } }
            }
          },
          "technology": {
            "type": "object",
            "properties": {
              "primaryLanguage": { "type": "string", "example": "TypeScript" },
              "frameworks": { "type": "array", "items": { "type": "string" }, "example": ["Next.js", "React"] },
              "hasWorkflows": { "type": "boolean", "example": true },
              "workflowCount": { "type": "number", "example": 3 }
            }
          },
          "activity": {
            "type": "object",
            "properties": {
              "commitCount30d": { "type": "number", "example": 42 },
              "commitCount90d": { "type": "number", "example": 120 },
              "commitCount180d": { "type": "number", "example": 250 },
              "lastCommitAt": { "type": "string", "example": "2026-07-24T18:00:00Z" }
            }
          },
          "strengths": { "type": "array", "items": { "type": "string" }, "example": ["Comprehensive test suite", "Active maintainers"] },
          "risks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": { "type": "string", "example": "low_test_coverage" },
                "title": { "type": "string", "example": "Moderate Test Coverage" },
                "severity": { "type": "string", "example": "low" },
                "description": { "type": "string", "example": "Some helper functions lack unit tests." },
                "impact": { "type": "string", "example": "Potential edge case bugs in error handlers." }
              }
            }
          },
          "questionsBeforeAdoption": { "type": "array", "items": { "type": "string" }, "example": ["What is the long-term maintenance roadmap?"] },
          "confidence": { "type": "string", "example": "high" },
          "verification": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "example": "verified" },
              "network": { "type": "string", "example": "arc-testnet" },
              "proofs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "receiptId": { "type": "string", "example": "rcpt_01h9a8b7" },
                    "txHash": { "type": "string", "nullable": true, "example": "0xabcd1234ef567890" },
                    "status": { "type": "string", "example": "verified" },
                    "explorerUrl": { "type": "string", "example": "https://testnet.arcscan.app/tx/0xabcd1234ef567890" }
                  }
                }
              }
            }
          },
          "generatedAt": { "type": "string", "format": "date-time", "example": "2026-07-24T21:05:00.000Z" }
        }
      },
      "AgentTrustReportResponse": {
        "type": "object",
        "required": [
          "kind",
          "version",
          "workflowType",
          "reportId",
          "input",
          "subject",
          "trustScore",
          "executiveSummary",
          "identity",
          "codeIntelligence",
          "executionReliability",
          "paymentsAndReceipts",
          "services",
          "contractTransparency",
          "endpointAvailability",
          "evidenceBackedStrengths",
          "risksAndReviewItems",
          "questionsBeforeIntegration",
          "dataFreshness",
          "unavailableSources",
          "limitations",
          "verification",
          "generatedAt"
        ],
        "properties": {
          "kind": { "type": "string", "enum": ["agent_trust_report"] },
          "version": { "type": "integer", "enum": [1] },
          "workflowType": { "type": "string", "enum": ["agent_trust_report"] },
          "reportId": { "type": "string" },
          "input": { "$ref": "#/components/schemas/AgentTrustReportInput" },
          "subject": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "agentId": { "type": "string", "nullable": true },
              "wallet": { "type": "string", "nullable": true },
              "repository": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "fullName": { "type": "string" },
                  "canonicalUrl": { "type": "string" }
                }
              }
            }
          },
          "trustScore": {
            "type": "object",
            "required": ["overall", "status", "categories", "excludedCategories"],
            "properties": {
              "overall": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "nullable": true,
                "description": "Deterministic confidence-weighted score; null when fewer than two categories are scorable"
              },
              "status": {
                "type": "string",
                "enum": ["strong_signals", "review_recommended", "high_attention", "limited_data"]
              },
              "categories": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "score": { "type": "integer", "minimum": 0, "maximum": 100, "nullable": true },
                    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
                    "evidenceCount": { "type": "integer" },
                    "summary": { "type": "string" },
                    "positiveSignals": { "type": "array", "items": { "type": "object" } },
                    "reviewItems": { "type": "array", "items": { "type": "object" } }
                  }
                }
              },
              "excludedCategories": { "type": "array", "items": { "type": "string" } }
            }
          },
          "executiveSummary": { "type": "array", "items": { "type": "string" } },
          "identity": { "type": "object" },
          "codeIntelligence": { "type": "object" },
          "executionReliability": { "type": "object" },
          "paymentsAndReceipts": { "type": "object" },
          "services": { "type": "object" },
          "contractTransparency": { "type": "object" },
          "endpointAvailability": { "type": "object" },
          "evidenceBackedStrengths": { "type": "array", "items": { "type": "object" } },
          "risksAndReviewItems": { "type": "array", "items": { "type": "object" } },
          "questionsBeforeIntegration": { "type": "array", "items": { "type": "string" } },
          "dataFreshness": { "type": "array", "items": { "type": "object" } },
          "unavailableSources": { "type": "array", "items": { "type": "string" } },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "verification": {
            "type": "object",
            "required": ["status", "verifiedOnArc", "network", "chainId", "reportHash", "proofs"],
            "properties": {
              "status": { "type": "string", "enum": ["verified", "verification_pending", "verification_failed"] },
              "verifiedOnArc": {
                "type": "boolean",
                "description": "True only when a verified Arc proof response hash exactly matches reportHash"
              },
              "network": { "type": "string", "enum": ["arc-testnet"] },
              "chainId": { "type": "integer", "enum": [5042002] },
              "reportHash": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$",
                "description": "Deterministic SHA-256 hash of the canonical report evidence and score snapshot"
              },
              "proofs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "receiptId": { "type": "string" },
                    "status": { "type": "string", "enum": ["pending", "verified", "failed"] },
                    "transactionHash": { "type": "string", "nullable": true },
                    "explorerUrl": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          },
          "generatedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input or repository reference",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MachineError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid Bearer token credential",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MachineError"
            }
          }
        }
      },
      "PaymentRequired": {
        "description": "Payment authorization required for paid workflow quote",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MachineError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Credential scope denied or workflow disabled",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MachineError"
            }
          }
        }
      },
      "NotFound": {
        "description": "Quote, run, or report not found or unowned",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MachineError"
            }
          }
        }
      },
      "Conflict": {
        "description": "Idempotency conflict, mutation already in progress, or quote already executed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MachineError"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Spending limit or rate policy exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MachineError"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MachineError"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Downstream x402 service or provider unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MachineError"
            }
          }
        }
      }
    }
  }
}
